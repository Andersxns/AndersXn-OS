# ---------------------------------------------------------------------------
# System value lists
#
# Timezone, locale and keymap are picked from lists rather than typed. Typing
# them is a trap: "Europe/London" is easy, but the installer silently accepts
# "GMT+1" or "en_GB.utf8" and the mistake only surfaces on the installed
# machine. Each list is read from the live system, with a fallback so a missing
# data file degrades to a short usable list instead of an empty dropdown.
# ---------------------------------------------------------------------------
def _run(argv):
    try:
        out = subprocess.run(argv, capture_output=True, text=True,
                             timeout=15, check=False)
        return out.stdout if out.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def list_timezones():
    out = _run(["timedatectl", "list-timezones"])
    zones = [z.strip() for z in out.splitlines() if z.strip()]
    if zones:
        return zones

    # zone1970.tab column 3 is the zone name; it omits the legacy aliases that
    # walking the whole zoneinfo tree would pull in.
    for tab in ("/usr/share/zoneinfo/zone1970.tab", "/usr/share/zoneinfo/zone.tab"):
        try:
            with open(tab, encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith("#"):
                        continue
                    parts = line.split("	")
                    if len(parts) >= 3 and parts[2].strip():
                        zones.append(parts[2].strip())
        except OSError:
            continue
        if zones:
            break

    if not zones:
        zones = ["UTC", "Europe/London", "Europe/Oslo", "America/New_York"]
    zones = sorted(set(zones))
    if "UTC" not in zones:
        zones.insert(0, "UTC")
    return zones


def list_locales():
    locales = []
    try:
        with open("/usr/share/i18n/SUPPORTED", encoding="utf-8") as fh:
            for line in fh:
                name = line.split()[0] if line.split() else ""
                # UTF-8 only: shipping a latin-1 default in 2026 would be a
                # disservice, and the list is long enough already.
                if name.endswith(".UTF-8"):
                    locales.append(name)
    except OSError:
        pass
    if not locales:
        locales = ["en_US.UTF-8", "en_GB.UTF-8", "de_DE.UTF-8", "fr_FR.UTF-8"]
    return sorted(set(locales))


def list_keyboard_layouts():
    """
    Keyboard layouts, as (code, description) pairs.

    Read from xkb-data rather than /usr/share/keymaps. Debian no longer ships
    the old console keymap tree - console-setup generates console maps from
    this same XKB data - and on a desktop the XKB layout is the one that
    actually governs what the keys do. The installer writes it to both
    /etc/default/keyboard and /etc/vconsole.conf so console and desktop agree.
    """
    layouts = []
    try:
        with open("/usr/share/X11/xkb/rules/base.lst", encoding="utf-8") as fh:
            in_section = False
            for line in fh:
                if line.startswith("! layout"):
                    in_section = True
                    continue
                if line.startswith("!"):
                    in_section = False
                if not in_section or not line.strip():
                    continue
                parts = line.split(None, 1)
                if len(parts) == 2:
                    layouts.append((parts[0].strip(), parts[1].strip()))
    except OSError:
        pass

    if not layouts:
        layouts = [("us", "English (US)"), ("gb", "English (UK)"),
                   ("de", "German"), ("fr", "French"), ("es", "Spanish"),
                   ("no", "Norwegian"), ("se", "Swedish"), ("dk", "Danish")]

    # Sort by description, but keep US first: it is the default and the one
    # most operators want at the top rather than hunting for.
    layouts.sort(key=lambda kv: (kv[0] != "us", kv[1]))
    return layouts


