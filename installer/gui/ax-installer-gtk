# ---------------------------------------------------------------------------
# Backend plumbing
# ---------------------------------------------------------------------------
def backend_path():
    """Locate ax-installer, preferring PATH and falling back to the live ISO."""
    found = shutil.which(BACKEND)
    if found:
        return found
    for candidate in ("/usr/bin/ax-installer", "/usr/local/bin/ax-installer"):
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def probe():
    """Ask the engine what this machine looks like."""
    exe = backend_path()
    if exe is None:
        return None, "ax-installer was not found on PATH"
    try:
        out = subprocess.run(
            [exe, "--probe"], capture_output=True, text=True, timeout=60, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, "running ax-installer --probe: %s" % exc
    if out.returncode != 0:
        return None, (out.stderr or "ax-installer --probe failed").strip()
    try:
        return json.loads(out.stdout), None
    except json.JSONDecodeError as exc:
        return None, "ax-installer --probe returned invalid JSON: %s" % exc


def escalation_prefix():
    """
    How to become root for the install step.

    The GUI itself runs unprivileged so a crash in the UI cannot damage a disk;
    only the install subprocess is escalated. On the live medium sudo is
    passwordless (see build/stages/25-desktop.sh); pkexec covers an installed
    system where an operator launched the installer by hand.
    """
    if os.geteuid() == 0:
        return []
    if shutil.which("sudo"):
        probe_sudo = subprocess.run(
            ["sudo", "-n", "true"], capture_output=True, check=False
        )
        if probe_sudo.returncode == 0:
            return ["sudo", "-n"]
    if shutil.which("pkexec"):
        return ["pkexec"]
    if shutil.which("sudo"):
        return ["sudo"]
    return []


