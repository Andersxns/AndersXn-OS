# The wizard window
# ---------------------------------------------------------------------------
class InstallerWindow(Gtk.ApplicationWindow):
    def __init__(self, app, info, probe_error):
        super().__init__(application=app)
        self.info = info or {}
        self.probe_error = probe_error
        self.page = 0
        self.install_started = False
        self.install_failed = False
        self.proc = None
        self._last_was_progress = False

        name = self.info.get("name", "AndersXn OS")
        version = self.info.get("version", "1.0")
        self.set_title("%s %s installer" % (name, version))
        self.set_default_size(1040, 700)

        # The live session runs this as the whole session, with a window
        # manager and nothing else - no panel, no desktop. Fullscreen there
        # so it does not float on a bare root window; windowed when someone
        # launches it from an installed system's menu.
        if os.environ.get("AXOS_INSTALLER_KIOSK") == "1":
            self.fullscreen()

        # Selection state
        self.disks = self.info.get("disks", [])
        self.modules = self.info.get("modules", [])
        self.sel_disk = self.disks[0]["path"] if self.disks else ""
        self.sel_scheme = "wipe"
        self.sel_fs = self.info.get("defaults", {}).get("fs", "btrfs")
        self.sel_encrypt = False
        self.sel_modules = {
            m["id"]: bool(m.get("default_on")) for m in self.modules
        }

        root = hbox(0)
        root.add_css_class("axos-root")
        self.set_child(root)

        root.append(self._build_sidebar())

        right = vbox(0)
        right.set_hexpand(True)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(160)
        self.stack.set_vexpand(True)
        right.append(self.stack)
        right.append(self._build_actionbar())
        root.append(right)

        self._build_pages()
        self._show_page(0)

    # --- sidebar -----------------------------------------------------------
    def _build_sidebar(self):
        side = vbox(4)
        side.add_css_class("axos-sidebar")
        side.set_size_request(240, -1)

        logo_box = vbox(6, margin=20)
        if os.path.exists(LOGO_PNG):
            pic = Gtk.Picture.new_for_filename(LOGO_PNG)
            pic.set_size_request(120, 120)
            pic.set_can_shrink(True)
            logo_box.append(pic)
        title = label(self.info.get("name", "AndersXn OS"), "axos-title", xalign=0.5)
        title.set_justify(Gtk.Justification.CENTER)
        logo_box.append(title)
        logo_box.append(label(
            "%s (%s)" % (self.info.get("version", ""), self.info.get("codename", "")),
            "axos-subtitle", xalign=0.5))
        side.append(logo_box)

        self.step_labels = []
        for i, step in enumerate(STEPS):
            lb = label("%d.  %s" % (i + 1, step), "axos-step")
            side.append(lb)
            self.step_labels.append(lb)

        spacer = vbox()
        spacer.set_vexpand(True)
        side.append(spacer)

        foot = vbox(2, margin=16)
        foot.append(label("%s  %s" % (
            self.info.get("firmware", "?"), self.info.get("arch", "?")),
            "axos-muted"))
        side.append(foot)
        return side

    def _build_actionbar(self):
        bar = hbox(10)
        bar.set_margin_top(14)
        bar.set_margin_bottom(18)
        bar.set_margin_start(28)
        bar.set_margin_end(28)

        self.btn_back = Gtk.Button(label="Back")
        self.btn_back.add_css_class("axos-ghost")
        self.btn_back.connect("clicked", self.on_back)
        bar.append(self.btn_back)

        gap = hbox()
        gap.set_hexpand(True)
        bar.append(gap)

        self.hint = label("", "axos-muted", xalign=1.0)
        bar.append(self.hint)

        self.btn_next = Gtk.Button(label="Next")
        self.btn_next.add_css_class("axos-primary")
        self.btn_next.connect("clicked", self.on_next)
        bar.append(self.btn_next)
        return bar

    # --- pages -------------------------------------------------------------
    def _page(self, title, subtitle):
        outer = vbox(14, margin=28)
        outer.append(label(title, "axos-title"))
        if subtitle:
            outer.append(label(subtitle, "axos-subtitle"))
        return outer

    def _scroller(self, child):
        sc = Gtk.ScrolledWindow()
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_vexpand(True)
        sc.set_child(child)
        return sc

    def _build_pages(self):
        self.stack.add_named(self._page_welcome(), "0")
        self.stack.add_named(self._page_disk(), "1")
        self.stack.add_named(self._page_layout(), "2")
        self.stack.add_named(self._page_system(), "3")
        self.stack.add_named(self._page_account(), "4")
        self.stack.add_named(self._page_software(), "5")
        self.stack.add_named(self._page_review(), "6")
        self.stack.add_named(self._page_install(), "7")

    def _page_welcome(self):
        p = self._page("Welcome",
                       "This will install %s on this machine."
                       % self.info.get("name", "AndersXn OS"))
        grid = vbox(6)
        for k, v in (
            ("Firmware", self.info.get("firmware", "unknown")),
            ("Architecture", self.info.get("arch", "unknown")),
            ("Live medium", "yes" if self.info.get("is_live") else "no"),
        ):
            row = hbox(10)
            lb = label(k, "axos-muted")
            lb.set_size_request(140, -1)
            row.append(lb)
            row.append(label(v))
            grid.append(row)
        p.append(grid)

        if self.probe_error:
            p.append(label("Could not inspect this machine: %s" % self.probe_error,
                           "axos-err"))
            return p

        warning = self.info.get("warning", "")

        # The backend reports "not running as root" because the GUI genuinely is
        # unprivileged - deliberately, so a crash in the UI cannot touch a disk.
        # Only the install step escalates. Repeating the backend's warning here
        # would tell the operator their install is doomed when it is not; it is
        # only worth saying when we actually cannot become root.
        if "not running as root" in warning:
            if escalation_prefix():
                warning = ""
            else:
                warning = ("This session cannot obtain root: neither sudo nor "
                           "pkexec is available. The install will fail at the "
                           "first write.")

        if warning:
            p.append(label(warning, "axos-warn"))
        return p

    def _page_disk(self):
        p = self._page("Select a disk",
                       "Everything on the chosen disk will be erased.")
        body = vbox(10)
        if not self.disks:
            body.append(label(
                "No installable disks were found. AndersXn needs a disk of at "
                "least 2 GiB.", "axos-err"))
        self.disk_buttons = []
        first = None
        for d in self.disks:
            btn = Gtk.CheckButton()
            if first is None:
                first = btn
            else:
                btn.set_group(first)
            btn.set_active(d["path"] == self.sel_disk)

            inner = vbox(2)
            inner.append(label("%s   %s" % (d["path"], d.get("size_human", ""))))
            inner.append(label(d.get("describe", ""), "axos-muted"))
            if d.get("mounted"):
                inner.append(label(
                    "This disk has mounted partitions - it may be the medium "
                    "you booted from.", "axos-warn"))
            for part in d.get("partitions", []):
                inner.append(label(
                    "    %s   %s   %s%s" % (
                        part["path"], part.get("size_human", ""),
                        part.get("fstype") or "unformatted",
                        "   mounted at " + part["mountpoint"] if part.get("mountpoint") else ""),
                    "axos-muted axos-mono"))

            card = hbox(12)
            card.add_css_class("axos-card")
            card.append(btn)
            inner.set_hexpand(True)
            card.append(inner)
            btn.connect("toggled", self._on_disk_toggled, d["path"], card)
            if d["path"] == self.sel_disk:
                card.add_css_class("axos-card-selected")
            body.append(card)
            self.disk_buttons.append((btn, card, d["path"]))
        p.append(self._scroller(body))
        return p

    def _on_disk_toggled(self, btn, path, card):
        if not btn.get_active():
            return
        self.sel_disk = path
        for _b, c, pth in self.disk_buttons:
            if pth == path:
                c.add_css_class("axos-card-selected")
            else:
                c.remove_css_class("axos-card-selected")

    def _radio_group(self, container, options, selected, on_pick):
        """options: list of (value, title, description)."""
        first = None
        cards = {}
        for value, title, desc in options:
            btn = Gtk.CheckButton()
            if first is None:
                first = btn
            else:
                btn.set_group(first)
            btn.set_active(value == selected)

            inner = vbox(2)
            inner.append(label(title))
            inner.append(label(desc, "axos-muted"))
            inner.set_hexpand(True)

            card = hbox(12)
            card.add_css_class("axos-card")
            if value == selected:
                card.add_css_class("axos-card-selected")
            card.append(btn)
            card.append(inner)
            container.append(card)
            cards[value] = card

            def handler(b, v=value):
                if not b.get_active():
                    return
                on_pick(v)
                for k, c in cards.items():
                    if k == v:
                        c.add_css_class("axos-card-selected")
                    else:
                        c.remove_css_class("axos-card-selected")

            btn.connect("toggled", handler)
        return cards

    def _page_layout(self):
        p = self._page("Disk layout", "How the target disk is organised.")
        body = vbox(14)

        body.append(label("PARTITIONING", "axos-section"))
        self._radio_group(body, [
            ("wipe", "Erase disk",
             "Wipe the whole disk and use all of it. Everything on it is lost."),
            ("manual", "Use existing partitions",
             "You have already made a root partition and a FAT boot partition."),
        ], self.sel_scheme, self._set_scheme)

        body.append(label("ROOT FILESYSTEM", "axos-section"))
        self._radio_group(body, [
            ("btrfs", "btrfs  (recommended)",
             "Subvolumes, snapshots and zstd compression. The AndersXn default."),
            ("ext4", "ext4",
             "Conservative and universally understood. No snapshots."),
            ("xfs", "xfs",
             "Strong with large files and parallel I/O. No shrink, no snapshots."),
        ], self.sel_fs, self._set_fs)

        body.append(label("ENCRYPTION", "axos-section"))
        enc_card = hbox(12)
        enc_card.add_css_class("axos-card")
        self.chk_encrypt = Gtk.CheckButton()
        self.chk_encrypt.set_active(self.sel_encrypt)
        self.chk_encrypt.connect("toggled", self._on_encrypt_toggled)
        enc_inner = vbox(6)
        enc_inner.set_hexpand(True)
        enc_inner.append(label("Encrypt the root filesystem with LUKS2"))
        enc_inner.append(label(
            "You will be asked to unlock the disk at every boot.", "axos-muted"))
        self.luks_entry = Gtk.PasswordEntry()
        self.luks_entry.set_show_peek_icon(True)
        self.luks_entry.set_property("placeholder-text", "Passphrase (min 8 characters)")
        self.luks_entry.set_visible(self.sel_encrypt)
        self.luks_confirm = Gtk.PasswordEntry()
        self.luks_confirm.set_show_peek_icon(True)
        self.luks_confirm.set_property("placeholder-text", "Confirm passphrase")
        self.luks_confirm.set_visible(self.sel_encrypt)
        enc_inner.append(self.luks_entry)
        enc_inner.append(self.luks_confirm)
        enc_card.append(self.chk_encrypt)
        enc_card.append(enc_inner)
        body.append(enc_card)

        p.append(self._scroller(body))
        return p

    def _set_scheme(self, v):
        self.sel_scheme = v

    def _set_fs(self, v):
        self.sel_fs = v

    def _on_encrypt_toggled(self, btn):
        self.sel_encrypt = btn.get_active()
        self.luks_entry.set_visible(self.sel_encrypt)
        self.luks_confirm.set_visible(self.sel_encrypt)

    def _page_system(self):
        p = self._page("System settings",
                       "Identity and localisation for the installed machine.")
        d = self.info.get("defaults", {})
        body = vbox(12)

        # Hostname stays free text - it is genuinely arbitrary. The other three
        # are picked from what this system actually supports.
        self.e_hostname = Gtk.Entry(text=d.get("hostname", "andersxn"))
