def label(text, css=None, wrap=True, xalign=0.0):
    lb = Gtk.Label(label=text)
    lb.set_xalign(xalign)
    lb.set_wrap(wrap)
    lb.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if css:
        for cls in css.split():
            lb.add_css_class(cls)
    return lb


def vbox(spacing=10, margin=0):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing)
    if margin:
        box.set_margin_top(margin)
        box.set_margin_bottom(margin)
        box.set_margin_start(margin)
        box.set_margin_end(margin)
    return box


def hbox(spacing=10):
    return Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing)


class Choice:
    """
    A searchable dropdown over a list of strings.

    Gtk.DropDown needs an expression before it will enable its search entry,
    which is the difference between usable and unusable when the list is 400
    timezones long.
    """

    def __init__(self, items, selected=None, labels=None):
        self.items = list(items)
        shown = list(labels) if labels else self.items
        self.widget = Gtk.DropDown(model=Gtk.StringList.new(shown))
        self.widget.set_enable_search(True)
        self.widget.set_expression(
            Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        if selected in self.items:
            self.widget.set_selected(self.items.index(selected))

    def value(self):
        i = self.widget.get_selected()
        if 0 <= i < len(self.items):
            return self.items[i]
        return self.items[0] if self.items else ""


def form_row(text, widget):
    row = hbox(12)
    lb = label(text, "axos-muted")
    lb.set_size_request(150, -1)
    row.append(lb)
    widget.set_hexpand(True)
    row.append(widget)
    return row


