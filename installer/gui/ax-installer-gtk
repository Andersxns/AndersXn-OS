    def _page_software(self):
        p = self._page("Software",
                       "Stacks deployed automatically after the base install.")
        body = vbox(8)
        self.module_detail = label("", "axos-muted")

        current_cat = None
        for m in self.modules:
            if m.get("category") != current_cat:
                current_cat = m.get("category")
                body.append(label((current_cat or "").upper(), "axos-section"))

            chk = Gtk.CheckButton()
            chk.set_active(self.sel_modules.get(m["id"], False))
            chk.connect("toggled", self._on_module_toggled, m["id"])

            inner = vbox(2)
            inner.set_hexpand(True)
            head = hbox(8)
            head.append(label(m["name"]))
            if m.get("disk_gib"):
                head.append(label("~" + human_gib(m["disk_gib"]), "axos-muted"))
            inner.append(head)
            inner.append(label(m.get("summary", ""), "axos-muted"))
            inner.append(label(m.get("detail", ""), "axos-muted"))

            card = hbox(12)
            card.add_css_class("axos-card")
            card.append(chk)
            card.append(inner)
            body.append(card)

        self.software_note = label("", "axos-warn")
        body.append(self.software_note)
        p.append(self._scroller(body))
        return p

    def _on_module_toggled(self, btn, module_id):
        self.sel_modules[module_id] = btn.get_active()
        self._refresh_software_note()

    def _selected_module_ids(self):
        return [m["id"] for m in self.modules if self.sel_modules.get(m["id"])]

    def _resolve_requires(self, ids):
        """Expand a selection to a fixed point, as the engine does."""
        by_id = {m["id"]: m for m in self.modules}
        chosen = set(ids)
        added = set()
        changed = True
        while changed:
            changed = False
            for mid in list(chosen):
                for req in by_id.get(mid, {}).get("requires", []) or []:
                    if req not in chosen:
                        chosen.add(req)
                        added.add(req)
                        changed = True
        ordered = [m["id"] for m in self.modules if m["id"] in chosen]
        return ordered, sorted(added)

    def _refresh_software_note(self):
        ids = self._selected_module_ids()
        full, added = self._resolve_requires(ids)
        notes = []
        if added:
            notes.append("Also installing (required): " + ", ".join(added))
        if "docker" in full and "k3s" in full:
            notes.append(
                "Docker and K3s both manage packet forwarding rules; expect to "
                "hand-tune nftables if you run both on one node.")
        self.software_note.set_text("\n".join(notes))

    def _page_review(self):
        p = self._page("Review", "Nothing has been written yet.")
        self.review_box = vbox(6)
        p.append(self._scroller(self.review_box))
        self.review_danger = label("", "axos-err")
        danger = vbox(4)
        danger.add_css_class("axos-danger")
        danger.append(self.review_danger)
        p.append(danger)
        return p

    def _refresh_review(self):
        child = self.review_box.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.review_box.remove(child)
            child = nxt

        full, _added = self._resolve_requires(self._selected_module_ids())
        disk = next((d for d in self.disks if d["path"] == self.sel_disk), {})
        rows = [
            ("Disk", "%s   %s" % (self.sel_disk, disk.get("describe", ""))),
            ("Scheme", self.sel_scheme),
            ("Filesystem", self.sel_fs),
            ("Encryption", "LUKS2" if self.sel_encrypt else "none"),
            ("Firmware", self.info.get("firmware", "?")),
            ("Bootloader", "Limine"),
            ("Hostname", self.e_hostname.get_text()),
            ("Timezone", self.c_timezone.value()),
            ("Locale", self.c_locale.value()),
            ("Keyboard", self.c_keymap.value()),
            ("Account", self.e_user.get_text()),
            ("Software", ", ".join(full) if full else "none"),
        ]
        for k, v in rows:
            row = hbox(10)
            lb = label(k, "axos-muted")
            lb.set_size_request(150, -1)
            row.append(lb)
            row.append(label(v))
            self.review_box.append(row)

        self.review_danger.set_text(
            "Everything on %s (%s) will be destroyed. This cannot be undone."
            % (self.sel_disk, disk.get("size_human", "")))

    def _page_install(self):
        p = self._page("Installing", "")
        self.install_status = label("Preparing...", "axos-subtitle")
        p.append(self.install_status)

        self.progress = Gtk.ProgressBar()
        self.progress.set_show_text(True)
        p.append(self.progress)

        self.log_view = Gtk.TextView()
        self.log_view.set_editable(False)
        self.log_view.set_monospace(True)
        self.log_view.set_cursor_visible(False)
        self.log_buffer = self.log_view.get_buffer()
        sc = Gtk.ScrolledWindow()
        sc.set_vexpand(True)
        sc.set_child(self.log_view)
        p.append(sc)
        return p

    # --- navigation --------------------------------------------------------
    def _show_page(self, n):
        self.page = n
        self.stack.set_visible_child_name(str(n))

        for i, lb in enumerate(self.step_labels):
            for cls in ("axos-step-active", "axos-step-done"):
                lb.remove_css_class(cls)
            if i < n:
                lb.add_css_class("axos-step-done")
            elif i == n:
                lb.add_css_class("axos-step-active")

        if n == 6:
            self._refresh_review()
        if n == 5:
            self._refresh_software_note()

        self.btn_back.set_visible(0 < n < 7)
        if n == 6:
            self.btn_next.set_label("Install now")
        elif n == 7:
            self.btn_next.set_label("Reboot")
            self.btn_next.set_sensitive(False)
        else:
            self.btn_next.set_label("Next")
        self.hint.set_text("")

    def on_back(self, _btn):
        if self.page > 0:
            self._show_page(self.page - 1)

    def on_next(self, _btn):
        if self.page == 7:
            self._reboot()
            return
        if self.page == 6:
            self._start_install()
            return
        err = self._validate(self.page)
        if err:
            self.hint.set_text(err)
            self.hint.remove_css_class("axos-muted")
            self.hint.add_css_class("axos-err")
            return
        self.hint.remove_css_class("axos-err")
        self._show_page(self.page + 1)

    def _validate(self, page):
        if page == 1:
            if not self.sel_disk:
                return "Select a disk to continue"
            disk = next((d for d in self.disks if d["path"] == self.sel_disk), {})
            if disk.get("mounted"):
                return "That disk has mounted partitions - it may be your live medium"
        if page == 2 and self.sel_encrypt:
            pw = self.luks_entry.get_text()
            if len(pw) < 8:
                return "Encryption passphrase must be at least 8 characters"
            if pw != self.luks_confirm.get_text():
                return "Encryption passphrases do not match"
        if page == 3:
            host = self.e_hostname.get_text().strip()
            if not host:
                return "Hostname cannot be empty"
            ok_chars = all(c.isalnum() or c == "-" for c in host)
            if not ok_chars or host.startswith("-") or host.endswith("-"):
                return "Hostname may only contain letters, digits and interior hyphens"
        if page == 4:
            user = self.e_user.get_text().strip()
            if not user:
                return "Username cannot be empty"
            if user[0].isdigit():
                return "Username may not start with a digit"
            if user in ("root", "daemon", "bin", "sys", "nobody"):
                return "That username is reserved by the system"
            if not all(c.islower() or c.isdigit() or c in "-_" for c in user):
                return "Username may only contain lowercase letters, digits, - and _"
            if self.e_pw.get_text() != self.e_pw2.get_text():
                return "Passwords do not match"
            if not self.e_pw.get_text() and not self.e_sshkey.get_text().strip():
                return "Set a password or an SSH key, or the account cannot log in"
        return None

    # --- running the install ----------------------------------------------
    def _build_plan(self):
        full, _added = self._resolve_requires(self._selected_module_ids())
        return {
            "disk": self.sel_disk,
            "scheme": self.sel_scheme,
            "fs": self.sel_fs,
            "encrypt": self.sel_encrypt,
            "hostname": self.e_hostname.get_text().strip(),
            "timezone": self.c_timezone.value(),
            "locale": self.c_locale.value(),
            "keymap": self.c_keymap.value(),
            "username": self.e_user.get_text().strip(),
            "full_name": self.e_fullname.get_text().strip(),
            "ssh_key": self.e_sshkey.get_text().strip(),
            "modules": full,
            "dry_run": os.environ.get("AXOS_DRY_RUN") == "1",
        }

    @staticmethod
    def _is_progress(text):
        """A redrawn progress bar, e.g. '[=====   ] 45000/114122  39%'."""
        t = text.lstrip()
        return t.startswith("[") and "%" in t

    def _append_log(self, text):
        # unsquashfs redraws its progress bar with a carriage return, which
        # the backend now surfaces as a stream of separate lines. Appending
        # every redraw would push thousands of near-identical lines into the
        # view, so consecutive progress updates overwrite the previous one.
        progress = self._is_progress(text)
        if progress and self._last_was_progress:
            start = self.log_buffer.get_iter_at_line(
                max(0, self.log_buffer.get_line_count() - 2))
            self.log_buffer.delete(start, self.log_buffer.get_end_iter())
        self.log_buffer.insert(self.log_buffer.get_end_iter(), text + "\n")
        self._last_was_progress = progress

        # Keep the newest line in view without stealing focus.
        mark = self.log_buffer.create_mark(None, self.log_buffer.get_end_iter(), False)
        self.log_view.scroll_mark_onscreen(mark)
        self.log_buffer.delete_mark(mark)

    def _start_install(self):
        if self.install_started:
            return
        self.install_started = True
        self._show_page(7)
        self.btn_back.set_visible(False)
        self.btn_next.set_sensitive(False)

        exe = backend_path()
        if exe is None:
            self._install_failed("ax-installer was not found on PATH")
            return

        plan = self._build_plan()
        try:
            fd, plan_path = __import__("tempfile").mkstemp(
                prefix="axos-plan-", suffix=".json")
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(plan, fh)
            os.chmod(plan_path, 0o600)
        except OSError as exc:
            self._install_failed("could not write the plan file: %s" % exc)
            return
        self.plan_path = plan_path

        argv = escalation_prefix() + [exe, "--run-plan", plan_path]
        self._append_log("$ " + " ".join(argv))

        try:
            self.proc = Gio.Subprocess.new(
                argv,
                Gio.SubprocessFlags.STDIN_PIPE
                | Gio.SubprocessFlags.STDOUT_PIPE
                | Gio.SubprocessFlags.STDERR_MERGE,
            )
        except GLib.Error as exc:
            self._install_failed("could not start the installer: %s" % exc.message)
            return

        # Secrets go over stdin so they never reach argv or the plan file.
        secrets = json.dumps({
            "password": self.e_pw.get_text(),
            "luks_passphrase": self.luks_entry.get_text() if self.sel_encrypt else "",
        })
        stdin = self.proc.get_stdin_pipe()
        try:
            stdin.write_all(secrets.encode("utf-8"), None)
            stdin.close(None)
        except GLib.Error as exc:
            self._install_failed("could not send credentials: %s" % exc.message)
            return

        stream = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self._read_next(stream)
        self.proc.wait_async(None, self._on_proc_done)

    def _read_next(self, stream):
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line, stream)

    def _on_line(self, stream, result, _user):
        try:
            raw, _len = stream.read_line_finish_utf8(result)
        except GLib.Error:
            return
        if raw is None:
            return
        line = raw.strip()
        if line:
            self._handle_event(line)
        self._read_next(stream)

    def _handle_event(self, line):
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            # Anything the engine did not emit as JSON is still worth showing.
            self._append_log(line)
            return

        kind = ev.get("type")
        if kind == "progress":
            total = ev.get("total") or 1
            step = ev.get("step") or 0
            self.progress.set_fraction(max(0.0, min(1.0, ev.get("fraction", 0.0))))
            self.progress.set_text("%d/%d  %s" % (step, total, ev.get("name", "")))
            self.install_status.set_text(ev.get("name", ""))
        elif kind == "log":
            self._append_log(ev.get("line", ""))
        elif kind == "error":
            self._install_failed(ev.get("message", "unknown error"))
        elif kind == "done":
            self._install_ok()

    def _on_proc_done(self, proc, result):
        try:
            proc.wait_finish(result)
        except GLib.Error:
            pass
        self._cleanup_plan()
        # A non-zero exit without a JSON error event means the backend died
        # before it could report anything - a missing sudo rule, most often.
        if not self.install_failed and proc.get_exit_status() != 0 and \
                self.progress.get_fraction() < 1.0:
            self._install_failed(
                "the installer exited unexpectedly (status %d). "
                "Check that this session can escalate with sudo or pkexec."
                % proc.get_exit_status())

    def _cleanup_plan(self):
        path = getattr(self, "plan_path", None)
        if path and os.path.exists(path):
            try:
                os.unlink(path)
            except OSError:
                pass

    def _install_ok(self):
        self.progress.set_fraction(1.0)
        self.progress.set_text("complete")
        self.install_status.set_text("AndersXn OS is installed.")
        self.install_status.remove_css_class("axos-subtitle")
        self.install_status.add_css_class("axos-ok")
        self.btn_next.set_sensitive(True)
        self.hint.set_text("Remove the installation medium before rebooting.")

    def _install_failed(self, message):
        self.install_failed = True
        self._cleanup_plan()
        self.install_status.set_text("Installation failed")
        self.install_status.remove_css_class("axos-subtitle")
        self.install_status.add_css_class("axos-err")
        self._append_log("ERROR: " + message)
        self.progress.set_text("failed")
        self.btn_next.set_label("Quit")
        self.btn_next.set_sensitive(True)
        self.btn_next.disconnect_by_func(self.on_next)
        self.btn_next.connect("clicked", lambda _b: self.get_application().quit())

    def _reboot(self):
        for argv in (["systemctl", "reboot"], ["reboot"]):
            exe = shutil.which(argv[0])
            if exe:
                subprocess.Popen(escalation_prefix() + [exe] + argv[1:])
                return
        self.get_application().quit()


class InstallerApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.andersxn.Installer")

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        info, err = probe()
        win = InstallerWindow(self, info, err)
        win.present()


def main():
    settings = Gtk.Settings.get_default()
    if settings is not None:
        settings.set_property("gtk-application-prefer-dark-theme", True)
    return InstallerApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
