# AndersXn OS - Limine bootloader configuration (template).
#
# Rendered by build/stages/40-bootloader.sh for live media, and regenerated by
# AX-Installer for an installed system (see installer/internal/install/
# bootloader.go, which substitutes @ROOT_SPEC@, @KERNEL@ and @INITRD@).
#
# Limine is used instead of GRUB throughout AndersXn OS: one binary covers
# UEFI and legacy BIOS on both amd64 and arm64, the config is a flat readable
# file rather than a generated shell script, and it draws the brand wallpaper
# natively without a theme engine.
#
# Config syntax targets Limine 8.x / 9.x (path:/cmdline:/module_path:).

timeout: 5
default_entry: 1

# --- Branding ---------------------------------------------------------------
interface_branding: @NAME@ @VERSION@ (@CODENAME@)
interface_branding_colour: 6

# Palette order: black, red, green, yellow, blue, magenta, cyan, white.
# These are the AndersXn tokens from build/lib/common.sh.
term_palette: @INK@;e5484d;63d68a;e8b84b;4fc3f7;1b6ca8;6b7a90;@SNOW@
term_background: @INK@
term_foreground: @SNOW@

# The mark, centred over the ink backdrop. Generated from AXnobg.png at build
# time; falls back to a flat backdrop if the file is absent.
wallpaper: boot():/andersxn/splash.png
wallpaper_style: centered
backdrop: @INK@

# --- Entries ----------------------------------------------------------------
/@NAME@ @VERSION@
    comment: Boot @NAME@ normally
    protocol: linux
    path: boot():@KERNEL@
    cmdline: root=@ROOT_SPEC@ rw rootflags=subvol=@ quiet loglevel=3 splash vt.global_cursor_default=0
    module_path: boot():@INITRD@

/@NAME@ @VERSION@ (verbose)
    comment: Boot with kernel messages on the console
    protocol: linux
    path: boot():@KERNEL@
    cmdline: root=@ROOT_SPEC@ rw rootflags=subvol=@ loglevel=7
    module_path: boot():@INITRD@

/@NAME@ @VERSION@ (recovery shell)
    comment: Single-user maintenance shell
    protocol: linux
    path: boot():@KERNEL@
    cmdline: root=@ROOT_SPEC@ rw rootflags=subvol=@ single loglevel=7 systemd.unit=rescue.target
    module_path: boot():@INITRD@

/+Firmware
    //UEFI firmware setup
        protocol: efi
        image_path: fwsetup://
